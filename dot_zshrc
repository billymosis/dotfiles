# 2. MULTIPLEXER & WSL CONFIGURATION
# ==========================================
# hc | herdr | tmux | anything else (e.g. none) = plain shell
: ${MULTIPLEXER:=herdr}

ZSH_THEME="billy"
local my_plugins=(git)

# Only run if not in VSCode or herdr
if [[ "$TERM_PROGRAM" != "vscode" ]]; then

	# A. If we are ALREADY inside Tmux (The Inner Shell)
	# HC_TERMINAL_ID: a herdr-core terminal, which includes every Herdr desktop app pane.
	# REX_SESSION: a Rex pane, which is already a multiplexer.
	if [[ -n "$TMUX" || -n "$HERDR_ENV" || -n "$HC_TERMINAL_ID" || -n "$REX_SESSION" ]]; then
		# Fix WSL Interop (The "Socket" Issue)
		if [[ -n "$WSL_INTEROP" && "$(uname)" == "Linux" ]]; then
			export WSL_INTEROP=/run/WSL/$(ls -tr /run/WSL/ | grep interop | tail -1)
		fi

		# Load heavy plugins only inside tmux
		my_plugins+=(zsh-autosuggestions kubectl common-aliases)

	# B. If we are OUTSIDE Tmux (The Launcher)
	else
		session_name="BMP"

		# Attaching BLOCKS here until you detach. Exports are above this line so
		# the multiplexer inherits the correct PATH.
		case "$MULTIPLEXER" in
			hc)
				hc
				;;
			herdr)
				herdr --session "$session_name"
				;;
			tmux)
				# Ensure session exists
				tmux has-session -t=$session_name 2>/dev/null
				if [[ $? -ne 0 ]]; then
					TMUX='' tmux new-session -d -s "$session_name"
				fi

				tmux attach -t "$session_name"
				;;
		esac
	fi
fi

