# cdwt [query]: fuzzy-pick a git worktree of the current repo and cd into it.
cdwt() {
	(( $+commands[fzf] )) || { echo "cdwt: fzf not found" >&2; return 1 }
	git rev-parse --git-dir >/dev/null 2>&1 || { echo "cdwt: not in a git repo" >&2; return 1 }
	local sel
	sel=$(git worktree list | fzf --prompt='worktree ❯ ' --height=40% --reverse \
		--query="${1:-}" --select-1 --exit-0 \
		--preview='git -C {1} log --oneline -10 --color=always' --preview-window=right,50%) || return
	cd "${sel%% *}"
}

# herdr-nvim-nav passthrough: a live PID in the pane marker makes ctrl+h/j/k/l
# go to the app instead of moving herdr focus.
herdr_passthrough() {
	local cmd=$1; shift
	if [[ -z "$HERDR_PANE_ID" ]]; then
		command "$cmd" "$@"
		return
	fi
	local f="${XDG_CACHE_HOME:-$HOME/.cache}/herdr/nvim-panes/$HERDR_PANE_ID"
	mkdir -p "${f:h}"
	print -r -- $$ > "$f"
	command "$cmd" "$@"
	local rc=$?
	command rm -f "$f"
	return $rc
}
vi-sql() { herdr_passthrough vi-sql "$@" }
