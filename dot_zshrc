# Lazy-load SDKMAN. sdkman-init.sh costs ~300-500ms per shell; keep the current
# candidate binaries (java/gradle/spring) on PATH directly and defer the full
# init (the `sdk` function, completions, auto-env) until first `sdk` invocation.
# Caveat: .sdkmanrc directory auto-env won't fire until you've run `sdk` once.
if [[ -d "$SDKMAN_DIR" ]]; then
	for _sdk_bin in "$SDKMAN_DIR"/candidates/*/current/bin(N); do
		export PATH="$PATH:${_sdk_bin}"
	done
	unset _sdk_bin
	# Lazy init never sets JAVA_HOME; jdtls/gradle/maven need it for project import.
	[[ -d "$SDKMAN_DIR/candidates/java/current" ]] && \
		export JAVA_HOME="$SDKMAN_DIR/candidates/java/current"
	sdk() {
		unset -f sdk
		source "$SDKMAN_DIR/bin/sdkman-init.sh"
		sdk "$@"
	}
fi

# --- claude tmux pane picker -------------------------------------------------
# _claude_panes: emit "target<TAB>session<TAB>window<TAB>path" for every tmux
# pane whose controlling tty is running a `claude` process (matched by argv, so
# it works even when claude renames its process title to the version string).
_claude_panes() {
	{ ps -Ao tty=,command=; print '==='; \
	  tmux list-panes -a -F '#{pane_tty}|#{session_name}:#{window_index}.#{pane_index}|#{session_name}|#{window_name}|#{pane_current_path}'; } \
	| awk '
		BEGIN { phase = 1 }
		/^===$/ { phase = 0; next }
		phase {
			bin = $2; sub(/.*\//, "", bin)           # basename of argv[0]
			if (bin == "claude") tty["/dev/" $1] = 1
			next
		}
		{
			n = split($0, a, "|")                    # tty|target|session|window|path
			if (a[1] in tty)
				printf "%s\t%s\t%s\t%s\n", a[2], a[3], a[4], a[5]
		}'
}

# claudes: just print the table.
claudes() {
	local rows; rows=$(_claude_panes)
	[[ -z "$rows" ]] && { print "no claude panes found"; return 1; }
	print "TARGET\tSESSION\tWINDOW\tPATH\n$rows" | column -t -s $'\t'
}

# cjump [query]: fuzzy-pick a claude pane (fzf) and switch to it. Preview shows
# the live pane contents. Passing a query pre-filters fzf.
cjump() {
	emulate -L zsh
	local rows sel target
	rows=$(_claude_panes)
	[[ -z "$rows" ]] && { print "no claude panes found"; return 1; }

	sel=$(print "$rows" \
		| column -t -s $'\t' \
		| fzf --ansi --prompt='claude ❯ ' --height=40% --reverse \
		      --header='enter: jump   ·   search by window / path' \
		      --query="${1:-}" \
		      --preview='tmux capture-pane -ep -t {1} 2>/dev/null | tail -n 40' \
		      --preview-window='down,50%,wrap' \
		| awk '{print $1}')
	[[ -z "$sel" ]] && return

	if [[ -n "$TMUX" ]]; then
		tmux switch-client -t "${sel%%:*}" \; select-window -t "${sel%.*}" \; select-pane -t "$sel"
	else
		tmux select-window -t "${sel%.*}" \; select-pane -t "$sel"
		tmux attach -t "${sel%%:*}"
	fi
}

# Repeat a command N times
# Usage: repeat_cmd <count> <command...>
#        repeat_cmd 5 ./autocurl.sh --url '...' --data-raw '...'
repeat_cmd() {
  local count="$1"
  shift

  if [[ -z "$count" || ! "$count" =~ ^[0-9]+$ ]]; then
    echo "Usage: repeat_cmd <number_of_times> <command>"
    return 1
  fi

  for ((i = 1; i <= count; i++)); do
    echo "--- Execution $i of $count ---"
    "$@"
  done
}

# cjump on Ctrl-E: type-and-run macro (like gho); fire it at an empty prompt.
bindkey -s '^e' 'cjump\n'
