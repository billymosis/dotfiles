## Fuzzy-find a local repo directory and open its GitHub page in the browser
gho() {
    # 1. Run fzf and tell it to expect 'ctrl-o' as an alternative to 'Enter'
    local output
    output=$(find ~/work -mindepth 1 -maxdepth 1 -type d | fzf \
        --prompt="🚀 Select Repo [Enter: CD | Ctrl-O: Browser] ➔ " \
        --expect=ctrl-o)

    # If the user exited without selecting anything, stop here
    [ -z "$output" ] && return

    # 2. Extract the key pressed (line 1) and the directory path (line 2)
    local key selected_dir
    key=$(echo "$output" | sed -n '1p')
    selected_dir=$(echo "$output" | sed -n '2p')

    # If no directory was selected, stop here
    [ -z "$selected_dir" ] && return

    # 3. Determine action based on the key pressed
    if [ "$key" = "ctrl-o" ]; then
        # --- ACTION A: OPEN IN BROWSER ---
        local git_url browser_url
        git_url=$(git -C "$selected_dir" config --get remote.origin.url 2>/dev/null)

        if [ -n "$git_url" ]; then
            browser_url=$(echo "$git_url" | sed -E 's|git@github.com:|https://github.com/|; s|\.git$||; s|https://.*@github.com/|https://github.com/|')
        else
            local repo_name
            repo_name=$(basename "$selected_dir")
            browser_url="https://github.com/HydraXTrader/$repo_name"
        fi

        echo "Opening $browser_url ..."
        if [[ "$OSTYPE" == "darwin"* ]]; then
            open "$browser_url"
        else
            xdg-open "$browser_url" 2>/dev/null || explorer.exe "$browser_url"
        fi
    else
        # --- ACTION B: CD TO DIRECTORY (Default Enter) ---
        cd "$selected_dir" || return
    fi
}

