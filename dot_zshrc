# ^P command palette: fuzzy-list the functions & aliases defined in ~/.zshrc,
# each with the description from the comment directly above it, preview the
# source, and drop the chosen name onto the prompt line. A "what do I have?"
# reminder — new functions/aliases appear automatically, no registration.
_palette_entries() {
	emulate -L zsh
	local zrc="$HOME/.zshrc" line desc="" name aname aval
	while IFS= read -r line; do
		if [[ $line =~ '^[[:space:]]*#+[[:space:]]?(.*)$' ]]; then
			[[ -n $match[1] ]] && desc="${desc:+$desc }$match[1]"
			continue
		fi
		if [[ $line =~ '^(function[[:space:]]+)?([A-Za-z0-9_-]+)[[:space:]]*\(\)' ]]; then
			name=$match[2]
			if [[ $name != _* && $name != my_init && $name != *-widget && $name != compdef ]]; then
				printf '%-7s %-16s %s\t%s\n' '[fn]' "$name" "$desc" "$name"
			fi
			desc=""
			continue
		fi
		[[ -z $line ]] && continue
		desc=""
	done < "$zrc"
	while IFS= read -r line; do
		if [[ $line =~ '^alias[[:space:]]+([A-Za-z0-9_-]+)=(.*)$' ]]; then
			aname=$match[1]; aval=$match[2]
			aval=${aval#[\"\']}; aval=${aval%[\"\']}
			printf '%-7s %-16s %s\t%s\n' '[alias]' "$aname" "$aval" "$aname"
		fi
	done < "$zrc"
}

palette-widget() {
	emulate -L zsh
	(( $+commands[fzf] )) || { zle reset-prompt; return }
	local sel name
	local pv='awk -v n={2} '\''$0 ~ ("^(function[ ]+)?" n "[ ]*[(][)]"){p=1} $0 ~ ("^alias[ ]+" n "="){print;next} p{print} p&&$0=="}"{exit}'\'' ~/.zshrc'
	sel=$(_palette_entries | sort -f -t$'\t' -k2 | fzf \
		--delimiter=$'\t' --with-nth=1 --no-sort \
		--prompt='fn ❯ ' --height=60% --reverse \
		--header='enter: put name on line  ·  functions & aliases from ~/.zshrc' \
		--preview="$pv" --preview-window='right:55%:wrap')
	if [[ -n $sel ]]; then
		name=${sel##*$'\t'}
		LBUFFER+="${name} "
	fi
	zle reset-prompt
}
zle -N palette-widget
bindkey '^P' palette-widget

